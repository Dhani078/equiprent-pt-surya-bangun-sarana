# ============================================================================
# EquipRent MS — PT. SURYA BANGUN SARANA BANJARMASIN
# Salin berkas ini menjadi `.env` lalu isi nilainya. JANGAN commit `.env`.
# ============================================================================

# ----------------------------------------------------------------------------
# Keamanan aplikasi (Cloudflare Workers / API)
# ----------------------------------------------------------------------------

# Kunci penanda tangan session token (HMAC-SHA256). WAJIB diisi di produksi.
# Minimal 32 karakter acak. Bila kosong, server memakai kunci acak sementara
# sehingga semua sesi gugur setiap kali isolate baru dimuat (pengguna harus
# login ulang). Status ini dilaporkan oleh /api/health.
# Buat nilainya dengan: openssl rand -hex 32
SESSION_SECRET=

# Origin yang boleh memanggil API lintas domain, dipisah koma.
# Kosongkan bila SPA berada di domain yang sama dengan API (tidak ada header CORS).
# Contoh: https://equiprent.example.com,https://staging.equiprent.example.com
ALLOWED_ORIGINS=

# Akun demo (admin/staff/user) untuk keperluan peragaan & pengujian.
# Setel ke "false" di lingkungan produksi.
ALLOW_DEMO_ACCOUNTS=true

# ----------------------------------------------------------------------------
# TiDB Cloud Serverless (dipakai lapisan Workers)
# ----------------------------------------------------------------------------
# Catatan: selama DATABASE_URL belum diisi dengan kredensial sungguhan,
# aplikasi berjalan pada data contoh di memori. /api/health akan melaporkan
# data_mode: "IN_MEMORY_DEMO" — seluruh perubahan hilang saat isolate diganti.

TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_username.root
TIDB_PASSWORD=your_password
TIDB_DATABASE=db_surya_heavy_equipment
DATABASE_URL=mysql://your_username.root:your_password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/db_surya_heavy_equipment?ssl={"rejectUnauthorized":true}

# ----------------------------------------------------------------------------
# MySQL lokal (dipakai lapisan PHP / XAMPP)
# ----------------------------------------------------------------------------
# Jangan memakai akun root tanpa kata sandi di luar komputer pengembangan.

APP_ENV=development
DB_HOST=localhost
DB_NAME=db_surya_heavy_equipment
DB_USER=root
DB_PASS=

# ============================================================================
# EquipRent MS — PT. SURYA BANGUN SARANA BANJARMASIN
# ----------------------------------------------------------------------------
# Berkas CONTOH. Salin menjadi `.env` untuk pengembangan lokal:
#     cp .env.example .env
#
# ATURAN KEAMANAN (WAJIB DIBACA):
#   1. JANGAN PERNAH commit `.env`. Sudah ada di .gitignore.
#   2. JANGAN pakai prefiks `VITE_` pada variabel rahasia. Vite menyuntikkan
#      variabel `VITE_*` ke dalam bundle JavaScript klien yang diunduh
#      browser — kredensial akan terlihat publik. Cukup lihat catatan
#      commit "fix(db): ... fix VITE_DATABASE_URL".
#   3. Nilai di bawah adalah CONTOH / placeholder. Ganti semuanya.
#   4. Untuk Cloudflare Workers, `.env` TIDAK dibaca otomatis — variabel
#      harus didaftarkan sebagai secret/binding (lihat DEPLOYMENT_GUIDE.md
#      §4). Yang benar-benar dipakai Worker hanyalah DATABASE_URL.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Cloudflare Workers (lapisan API Hono)
#    Dipakai oleh: src/server/index.ts, src/lib/db.ts, src/lib/auth.ts
# ----------------------------------------------------------------------------

# Kunci penanda tangan session token (HMAC-SHA256). WAJIB >= 32 karakter.
# Bila kosong atau terlalu pendek, server memakai kunci ACAK SEMENTARA —
# semua sesi gugur setiap kali isolate Workers dimuat ulang dan pengguna
# harus login ulang. Status ini dilaporkan oleh GET /api/health.
# Buat dengan:  openssl rand -hex 32
SESSION_SECRET=

# Origin yang boleh memanggil API dari domain lain (CORS allowlist),
# dipisah koma. Contoh: https://equiprent.example.com,https://staging.equiprent.example.com
# Kosongkan bila SPA dan API berada di domain yang sama ( Worker +
# static assets satu domain) — saat kosong TIDAK ada header CORS
# dikirim, yang berarti browser hanya bisa memanggil dari domain sendiri.
ALLOWED_ORIGINS=

# Akun demo (admin/admin, staff/staff, user/user) untuk peragaan sidang.
# Setel "false" di produksi agar login demo ditolak.
# Dibaca di src/server/index.ts (bolehAkunDemo).
ALLOW_DEMO_ACCOUNTS=true

# ----------------------------------------------------------------------------
# 2. TiDB Cloud Serverless (dipakai lapisan Workers)
#    Dipakai oleh: src/lib/db.ts (hanya DATABASE_URL yang sebenarnya dibaca)
# ----------------------------------------------------------------------------
# Catatan: selama DATABASE_URL belum diisi dengan kredensial sungguhan,
# aplikasi berjalan pada data contoh di memori isolate. GET /api/health
# melaporkan data_mode: "IN_MEMORY_DEMO" — semua perubahan hilang saat
# isolate diganti. Ini berguna untuk demo tanpa biaya, BUKAN untuk produksi.
#
# Format DATABASE_URL (driver HTTP @tidbcloud/serverless):
#   mysql://<user>:<password>@<host>:4000/<database>?ssl={"rejectUnauthorized":true}
#
# Paramater TIDB_* di bawah HANYA dokumentasi untuk menyusun DATABASE_URL.
# Aplikasi tidak membacanya secara terpisah.

TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_username.root
TIDB_PASSWORD=your_password
TIDB_DATABASE=db_surya_heavy_equipment
DATABASE_URL=mysql://your_username.root:your_password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/db_surya_heavy_equipment?ssl={"rejectUnauthorized":true}

# ----------------------------------------------------------------------------
# 3. MySQL lokal (dipakai lapisan PHP / XAMPP)
#    Dipakai oleh: config/database.php
# ----------------------------------------------------------------------------
# Lapisan PHP (index.php, views/, controllers/) adalah warisan fase awal
# dan dipertahankan untuk perbandingan di laporan. JANGAN pakai akun root
# tanpa kata sandi di luar komputer pengembangan.

APP_ENV=development
DB_HOST=localhost
DB_NAME=db_surya_heavy_equipment
DB_USER=root
DB_PASS=

# ----------------------------------------------------------------------------
# 4. Daftar lengkap variabel lingkungan (cegah variabel yatim)
# ----------------------------------------------------------------------------
# Cloudflare Workers bindings (wrangler.jsonc):
#   ASSETS            — binding static assets (otomatis, bukan secret)
#
# Secrets / plaintext (dashboard Workers → Settings → Variables and Secrets):
#   DATABASE_URL          WAJIB produksi  (TiDB Cloud Serverless)
#   SESSION_SECRET        WAJIB produksi  (>= 32 karakter, lihat §1)
#   ALLOWED_ORIGINS       opsional        (kosongkan bila satu domain)
#   ALLOW_DEMO_ACCOUNTS   opsional        (default "true")
#
# Lapisan PHP: APP_ENV, DB_HOST, DB_NAME, DB_USER, DB_PASS.
#
# Tidak ada variabel lain. Bila menambah endpoint baru yang butuh konfigurasi,
# daftarkan di sini DAN di type Bindings src/server/index.ts.

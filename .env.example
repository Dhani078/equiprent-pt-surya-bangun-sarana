# ============================================================================
# PT. SURYA BANGUN SARANA BANJARMASIN — ENVIRONMENT CONFIGURATION
# ============================================================================
#
# Salin berkas ini menjadi `.env` untuk konfigurasi lokal, atau masukkan
# sebagai Cloudflare Environment Variables / Secrets di Cloudflare Dashboard.

# TiDB Cloud Serverless Connection
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_username.root
TIDB_PASSWORD=your_password
TIDB_DATABASE=db_surya_heavy_equipment
DATABASE_URL=mysql://your_username.root:your_password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/db_surya_heavy_equipment?ssl={"rejectUnauthorized":true}

# Fallback Data: Menjaga sistem tetap berjalan mulus dan responsif 
# dengan data default jika kredensial TiDB belum dimasukkan
USE_MOCK_FALLBACK=true
